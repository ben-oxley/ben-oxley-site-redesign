---
export interface Props {
  class?: string;
  width?: number;
  height?: number;
  density?: "sparse" | "medium" | "dense";
}

const { class: className, width = 400, height = 120, density = "medium" } = Astro.props;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 200" width={width} height={height} class={className} fill="none" aria-hidden="true">
  <g stroke="var(--contour-color, #b09dd4)" stroke-width="1.5" opacity="0.4" fill="none">
    {
      density === "dense" && (
        <>
          <!-- Top cluster -->
          <path d="M0 30 C80 20, 120 40, 180 25 C240 10, 300 35, 400 20"/>
          <path d="M0 40 C80 30, 120 50, 180 35 C240 20, 300 45, 400 30"/>
          <path d="M0 50 C80 40, 120 60, 180 45 C240 30, 300 55, 400 40"/>
          <path d="M0 60 C80 50, 120 70, 180 55 C240 40, 300 65, 400 50"/>
          <!-- Middle cluster -->
          <path d="M0 80 C60 70, 100 90, 160 85 C220 80, 280 100, 340 80 C370 70, 390 85, 400 80"/>
          <path d="M0 90 C60 80, 100 100, 160 95 C220 90, 280 110, 340 90 C370 80, 390 95, 400 90"/>
          <path d="M0 100 C60 90, 100 110, 160 105 C220 100, 280 120, 340 100 C370 90, 390 105, 400 100"/>
          <path d="M0 110 C60 100, 100 120, 160 115 C220 110, 280 130, 340 110 C370 100, 390 115, 400 110"/>
          <!-- Bottom cluster - concentric -->
          <path d="M80 180 C100 170, 130 175, 150 165 C170 155, 190 170, 210 160 C240 150, 280 165, 320 160"/>
          <path d="M90 175 C110 165, 140 170, 155 160 C170 150, 190 162, 205 155 C230 145, 270 158, 300 152"/>
          <path d="M100 170 C115 162, 140 165, 152 158 C165 150, 185 158, 200 152 C220 142, 250 152, 280 148"/>
          <path d="M110 165 C120 158, 140 160, 148 155 C158 148, 175 155, 192 148 C210 138, 235 148, 260 142"/>
          <path d="M120 160 C128 155, 140 156, 145 152 C152 146, 165 150, 178 146 C190 140, 210 145, 230 140"/>
        </>
      )
    }
    {
      density === "medium" && (
        <>
          <path d="M0 30 C60 20, 100 45, 160 30 C220 15, 280 40, 340 25 C370 20, 390 30, 400 25"/>
          <path d="M0 50 C60 40, 100 65, 160 50 C220 35, 280 60, 340 45 C370 40, 390 50, 400 45"/>
          <path d="M0 80 C50 70, 90 95, 150 85 C210 75, 270 100, 330 85 C360 78, 380 88, 400 82"/>
          <path d="M0 110 C50 100, 90 125, 150 115 C210 105, 270 130, 330 115 C360 108, 380 118, 400 112"/>
          <path d="M60 170 C80 160, 120 168, 160 155 C200 142, 240 160, 280 150 C310 142, 340 155, 380 148"/>
          <path d="M80 160 C100 150, 140 158, 170 145 C200 132, 230 150, 260 140 C290 132, 320 145, 350 138"/>
          <path d="M120 150 C140 142, 170 148, 190 138 C210 128, 230 140, 250 132 C270 124, 290 135, 310 128"/>
        </>
      )
    }
    {
      density === "sparse" && (
        <>
          <path d="M0 40 C80 25, 140 55, 220 35 C300 15, 360 50, 400 40"/>
          <path d="M0 80 C80 65, 140 95, 220 75 C300 55, 360 90, 400 80"/>
          <path d="M0 120 C80 105, 140 135, 220 115 C300 95, 360 130, 400 120"/>
          <path d="M0 160 C80 145, 140 175, 220 155 C300 135, 360 170, 400 160"/>
        </>
      )
    }
  </g>
  <!-- Elevation markers -->
  <g fill="var(--contour-color, #b09dd4)" opacity="0.25">
    <text x="10" y="44" font-size="8" font-family="monospace">320</text>
    <text x="10" y="84" font-size="8" font-family="monospace">280</text>
    <text x="10" y="124" font-size="8" font-family="monospace">240</text>
    <text x="10" y="164" font-size="8" font-family="monospace">200</text>
    <text x="200" y="44" font-size="8" font-family="monospace">310</text>
    <text x="200" y="124" font-size="8" font-family="monospace">230</text>
  </g>
</svg>