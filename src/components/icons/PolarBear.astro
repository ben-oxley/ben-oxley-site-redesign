---
export interface Props {
  size?: number;
  class?: string;
}

const { size = 120, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 200 200"
  width={size}
  height={size}
  class={className}
  fill="none"
  aria-label="Polar bear"
>
  <!-- Body -->
  <path d="M70 100 C70 100, 60 150, 75 170 C85 185, 115 185, 125 170 C140 150, 130 100, 130 100 Z"
        fill="var(--bear-body, #f0f0f0)" stroke="var(--bear-outline, #1a1a1a)" stroke-width="3"/>

  <!-- Left leg -->
  <path d="M78 165 C78 165, 72 185, 70 192 C68 198, 82 198, 82 192 C82 185, 82 165, 82 165 Z"
        fill="var(--bear-body, #f0f0f0)" stroke="var(--bear-outline, #1a1a1a)" stroke-width="3"/>
  <!-- Left paw pad (lime) -->
  <ellipse cx="76" cy="193" rx="6" ry="3" fill="var(--bear-accent, #A3E635)"/>

  <!-- Right leg -->
  <path d="M118 165 C118 165, 128 185, 130 192 C132 198, 118 198, 118 192 C118 185, 118 165, 118 165 Z"
        fill="var(--bear-body, #f0f0f0)" stroke="var(--bear-outline, #1a1a1a)" stroke-width="3"/>
  <!-- Right paw pad (lime) -->
  <ellipse cx="124" cy="193" rx="6" ry="3" fill="var(--bear-accent, #A3E635)"/>

  <!-- Head -->
  <ellipse cx="100" cy="62" rx="38" ry="34" fill="var(--bear-body, #f0f0f0)" stroke="var(--bear-outline, #1a1a1a)" stroke-width="3"/>

  <!-- Left ear -->
  <circle cx="68" cy="38" r="12" fill="var(--bear-body, #f0f0f0)" stroke="var(--bear-outline, #1a1a1a)" stroke-width="3"/>
  <!-- Left inner ear (lime) -->
  <circle cx="68" cy="38" r="5" fill="var(--bear-accent, #A3E635)"/>

  <!-- Right ear -->
  <circle cx="132" cy="38" r="12" fill="var(--bear-body, #f0f0f0)" stroke="var(--bear-outline, #1a1a1a)" stroke-width="3"/>
  <!-- Right inner ear (lime) -->
  <circle cx="132" cy="38" r="5" fill="var(--bear-accent, #A3E635)"/>

  <!-- Eyes -->
  <circle cx="86" cy="58" r="4" fill="var(--bear-outline, #1a1a1a)"/>
  <circle cx="114" cy="58" r="4" fill="var(--bear-outline, #1a1a1a)"/>

  <!-- Snout -->
  <ellipse cx="100" cy="74" rx="14" ry="10" fill="var(--bear-accent, #A3E635)" stroke="var(--bear-outline, #1a1a1a)" stroke-width="2"/>

  <!-- Nose -->
  <ellipse cx="100" cy="70" rx="5" ry="3.5" fill="var(--bear-outline, #1a1a1a)"/>

  <!-- Mouth -->
  <path d="M95 78 C97 82, 103 82, 105 78" stroke="var(--bear-outline, #1a1a1a)" stroke-width="2" stroke-linecap="round"/>

  <!-- Scarf/collar (lime accent) -->
  <path d="M68 92 C68 92, 80 105, 100 105 C120 105, 132 92, 132 92"
        stroke="var(--bear-accent, #A3E635)" stroke-width="6" stroke-linecap="round" fill="none"/>
  <path d="M120 98 C120 98, 125 110, 122 118 C119 126, 126 126, 128 118 C130 112, 122 98, 122 98"
        fill="var(--bear-accent, #A3E635)" stroke="var(--bear-accent, #A3E635)" stroke-width="2"/>

  <!-- Left arm -->
  <path d="M68 105 C68 105, 52 120, 50 135 C48 145, 56 145, 58 135 C60 125, 72 115, 72 115"
        fill="var(--bear-body, #f0f0f0)" stroke="var(--bear-outline, #1a1a1a)" stroke-width="3" stroke-linecap="round"/>

  <!-- Right arm -->
  <path d="M132 105 C132 105, 148 120, 150 135 C152 145, 144 145, 142 135 C140 125, 128 115, 128 115"
        fill="var(--bear-body, #f0f0f0)" stroke="var(--bear-outline, #1a1a1a)" stroke-width="3" stroke-linecap="round"/>

  <!-- Left arm paw pad (lime) -->
  <circle cx="54" cy="140" r="4" fill="var(--bear-accent, #A3E635)"/>
  <!-- Right arm paw pad (lime) -->
  <circle cx="146" cy="140" r="4" fill="var(--bear-accent, #A3E635)"/>
</svg>