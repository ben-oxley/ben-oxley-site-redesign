---
import { NAV } from "../config";
---

<header>
  <div class="container">
    <a href="/" class="logo" aria-label="Home">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" fill="none" aria-hidden="true">
        <circle cx="50" cy="50" r="45" stroke="var(--accent)" stroke-width="3" fill="var(--accent)" fill-opacity="0.1"/>
        <text x="50" y="50" dominant-baseline="central" text-anchor="middle"
              font-family="system-ui" font-weight="700" font-size="40"
              fill="var(--accent)">B</text>
      </svg>
      Ben Oxley
    </a>
    <nav aria-label="Main navigation">
      {NAV.map((link) => (
        <a href={link.href} aria-current={Astro.url.pathname === link.href ? "page" : undefined}>
          {link.text}
        </a>
      ))}
    </nav>
  </div>
</header>