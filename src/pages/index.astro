---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, SOCIAL } from "../config";
---

<BaseLayout>
  <section class="home-header">
    <h1>{SITE.title}</h1>
    <p class="subtitle">
      Chartered engineer, cloud architect, and builder of things at the intersection of hardware, software, and geospatial data.
    </p>
  </section>

  <section>
    <h2 class="section-title">Links</h2>
    <div class="link-grid">
      <a href="/blog" class="link-item">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
          <line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="14" y2="11"/>
        </svg>
        <div>
          <div>Blog</div>
          <div class="description">Thoughts, projects, and notes</div>
        </div>
      </a>

      <a href="/about" class="link-item">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <div>
          <div>About</div>
          <div class="description">Bio, projects, credentials</div>
        </div>
      </a>

      <a href="/cv" class="link-item">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
        </svg>
        <div>
          <div>CV / Résumé</div>
          <div class="description">Work history and experience</div>
        </div>
      </a>

      <a href={SOCIAL.github} target="_blank" class="link-item">
        <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <div>
          <div>GitHub</div>
          <div class="description">ben-oxley</div>
        </div>
      </a>

      <a href={SOCIAL.mastodon} target="_blank" class="link-item">
        <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M23.268 5.313c-.35-2.578-2.617-4.5-5.304-5.273 0 0-1.152-.352-3.464-.352H9.5c-2.313 0-3.465.352-3.465.352-2.687.773-4.954 2.695-5.304 5.273-.316 2.342-.574 5.617.07 9.79.235 1.539.707 2.93 1.543 4.145 1.375 2.008 3.316 3.547 5.41 4.375 1.09.434 2.254.625 3.399.601 1.703-.035 2.793-.398 3.793-.965l-.04-.848c-.855.332-2.262.668-3.754.574-1.25-.078-2.297-.29-3.246-.757-1.363-.668-2.64-1.695-3.7-3.05l8.77 2.16a31.087 31.087 0 0 0 4.137.488c1.086.047 2.191-.102 3.277-.403 2.254-.598 4.18-1.957 5.23-3.96.801-1.524 1.215-3.36 1.29-5.653.164-4.087.04-6.234-1.281-9.75zm-3.082 11.597h-2.218V9.594c0-1.145-.48-1.726-1.445-1.726-1.066 0-1.601.43-1.601 1.29v4.664H12.7V9.158c0-.86-.535-1.29-1.602-1.29-.964 0-1.445.582-1.445 1.727v7.316H7.43V9.41c0-1.426.36-2.559 1.079-3.399.743-.84 1.715-1.254 2.918-1.254 1.398 0 2.449.539 3.16 1.617l.68 1.133.68-1.133c.71-1.078 1.762-1.617 3.16-1.617 1.203 0 2.176.414 2.918 1.254.719.84 1.08 1.973 1.08 3.399z"/>
        </svg>
        <div>
          <div>Mastodon</div>
          <div class="description">@boxly@hachyderm.io</div>
        </div>
      </a>

      <a href={SOCIAL.twitter} target="_blank" class="link-item">
        <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        <div>
          <div>𝕏 / Twitter</div>
          <div class="description">@benoxley</div>
        </div>
      </a>

      <a href={SOCIAL.matrix} target="_blank" class="link-item">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        <div>
          <div>Matrix</div>
          <div class="description">@boxly:matrix.org</div>
        </div>
      </a>

      <a href={SOCIAL.instagram} target="_blank" class="link-item">
        <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
        </svg>
        <div>
          <div>Instagram</div>
          <div class="description">benoxley</div>
        </div>
      </a>

      <a href="https://oxleycartography.com" target="_blank" class="link-item">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/>
          <line x1="8" y1="2" x2="8" y2="18"/>
          <line x1="16" y1="6" x2="16" y2="22"/>
        </svg>
        <div>
          <div>Oxley Cartography</div>
          <div class="description">3D printed terrain maps</div>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>